{
  "name": "ai-conference-bot",
  "version": "1.0.0",
  "description": "Telegram bot for AI/ML conference paper deadlines, on Cloudflare Workers + D1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "fetch:ranks": "node scripts/fetch_core_ranks.mjs",
    "fetch:rates": "node scripts/fetch_acceptance_rates.mjs && node scripts/generate_seed.mjs",
    "setup": "node scripts/setup_telegram.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.4.1",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.129.0"
  }
}
