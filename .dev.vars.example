# Copy to .dev.vars for local development, and set these in
# production with `wrangler secret put <NAME>`.

TELEGRAM_BOT_TOKEN="123456:your-bot-token"
ADMIN_TELEGRAM_ID="your-numeric-telegram-user-id"

# Any random string; must match the secret_token given to setWebhook.
TELEGRAM_WEBHOOK_SECRET="change-me"

# Public origin of the worker, used to build Mini App URLs.
PUBLIC_URL="http://localhost:8787"
