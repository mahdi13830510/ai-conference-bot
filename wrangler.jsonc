/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-confrence-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/*
	 * Public origin of this Worker. Telegram needs an absolute
	 * HTTPS URL for Mini App buttons, and a Worker cannot infer
	 * its own hostname. Not a secret, so it lives here.
	 */
	"vars": {
		"PUBLIC_URL": "https://ai-confrence-bot.ai-confrence.workers.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ai-conference-bot-db",
			"database_id": "2de30657-1432-49bf-b31c-7554c2955834",
			"remote": true,
			"migrations_dir": "migrations"
		}
	],
	/*
	 * Hourly drives per-user digest hours and timely reminders;
	 * the six-hourly tick additionally pulls the sources.
	 */
	"triggers": {
		"crons": [
			"0 * * * *",
			"0 */6 * * *"
		]
	}
}
